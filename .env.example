# Free-tier LLM providers. Hindsight uses the first key present, in this order.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=


# Model pins. Free-tier model names and limits move; override without editing code.
# Measured 2026-08-30: gemini-3.5-flash is 20 requests/DAY on the free tier.
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
